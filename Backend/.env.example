# GitViz backend / data layer configuration

# HTTP port used by the data API (the frontend Vite proxy targets 3000)
PORT=3000
CORS_ORIGIN=*

# PostgreSQL connection. Use DATABASE_URL, or the standard PG* variables.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gitviz
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=gitviz

# Path to the editable generated-file ignore list (P2 rule #5)
GITVIZ_IGNORE_LIST=./config/ignore-list.json

# Rows per bulk INSERT statement during ingest
INGEST_BATCH_SIZE=1000
